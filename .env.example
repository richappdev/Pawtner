# Supabase Development (https://rlwctljjjvlxrexcgqmg.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://rlwctljjjvlxrexcgqmg.supabase.co
# Prefer the publishable key for new projects. ANON_KEY remains supported for existing projects.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Firebase (project pawtner-app-2026) — public web config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=pawtner-app-2026.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=pawtner-app-2026
NEXT_PUBLIC_FIREBASE_APP_ID=1:611592714843:web:b10424774e91a6ff9add7e
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=611592714843
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=pawtner-app-2026.firebasestorage.app

# Firebase Admin (local/dev). On App Hosting prefer ADC; omit private key there.
FIREBASE_ADMIN_PROJECT_ID=pawtner-app-2026
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Dual-auth bridge (Phase 2+). Keep false for Phase 1 hosting-only.
FEATURE_FIREBASE_AUTH_ENABLED=false
NEXT_PUBLIC_FEATURE_FIREBASE_AUTH_ENABLED=false

# Optional
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
AI_API_KEY=
AI_BASE_URL=
PAYMENT_WEBHOOK_SECRET=
FEATURE_AI_ENABLED=true
FEATURE_COMMERCE_ENABLED=true
