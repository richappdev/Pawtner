{
  "auth": {
    "providers": {
      "emailPassword": true
    }
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "ui": {
      "enabled": true,
      "port": 4000
    }
  },
  "hosting": {
    "target": "staging",
    "public": "public",
    "ignore": [
      "firebase.staging.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "pawtner-hosting-web",
          "region": "asia-east1",
          "pinTag": true
        }
      }
    ]
  }
}
